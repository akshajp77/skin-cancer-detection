# Copy this file to .env for local dev, or set this variable directly
# in your hosting provider's dashboard (e.g. Vercel > Project > Settings > Environment Variables)
#
# Local development (default if unset):
# VITE_API_URL=http://127.0.0.1:8000
#
# Production (point at your deployed FastAPI backend, no trailing slash):
VITE_API_URL=https://your-backend.onrender.com
